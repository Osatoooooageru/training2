
<div class="hero">
  <div class="hero-text">
    <h2>自宅での運動をサポート!!!!!</h2>
  </div>
</div>

<div class="menu">
     <h3>おすすめトレーニング診断</h3>
     <p>これから筋トレ・ダイエットを始める方や、メニューを変えてみたい方へ…！</p>
     <%= button_to "診断する", menus_path, method: :get, class: "index-btn"  %>
</div>

<section id="searchgo" class="search">
      <h3>トレーニングを検索</h3>
      <p>トレーニングについて詳しく知りたい方へ…！</p>
            <p class="narrowing">フリーワード検索</p>
            <%= form_tag tweets_path(anchor: "searchgo"), method: :get, data: { turbo: false } do %>
              <%= text_field_tag :search, nil, class: "search-tag" %>
              <%= submit_tag "検索する", class: "search-btn" %>
            <% end %>
            
            <p class="narrowing">条件を絞って検索</p>
            <%= form_with(
                url: tweets_path(anchor: "searchgo"),
                method: :get,
                local: true,
                data: { turbo: false }
              ) do |f| %>

                  <div class="narrowingitem">
                    <div>
                      <%= f.label :genre, "トレーニング名",class: "search-point" %>
                      <%= f.text_field :genre %>
                    </div>

                    <div>
                      <%= f.label :level, "難易度",class: "search-point" %>
                      <%= f.select :level,
                      ["みんなにおすすめ",
                        "初心者向け",
                        "中級者向け",
                        "上級者向け" ],
                      include_blank: "選択してください" %>
                    </div>

                    <div>
                      <%= f.label :part, "鍛えられる部位",class: "search-point" %>
                      <%= f.text_field :part %>
                    </div>

                    <div>
                      <%= f.label :tool, "器具",class: "search-point" %>
                      <%= f.select :tool,
                      ["必要",
                        "不要"],
                      include_blank: "選択してください" %>
                    </div>

                    <div>
                        <%= f.label :size,"必要なスペース",class: "search-point" %>
                        <%= f.select :size, 
                        [ "大の字で寝れる", 
                          "腕のみを広げて寝れる", 
                          "縦にまっすぐ寝れる", 
                          "その場で立つ・しゃがむのみ"], 
                        include_blank: "選択して下さい" %>
                      </div>
                    
                    <div>
                      <%= f.label :jump,"ジャンプ",class: "search-point" %>
                      <%= f.select :jump, 
                      ["あり", 
                      "なし",],
                      include_blank: "選択して下さい" %>
                    </div>
                  </div>
                    <%= f.submit "検索する", class: "search-btn" %>
                <% end %>
      
</section>

<div class="tweets-new">
<%= button_to "+ 新しいトレーニングを投稿する", new_tweet_path, method: :get, class: "index-btn" %>

<div class="tweets-container">
  <% @tweets.each do |t| %>
    <div class="tweet-card">
    
        <div class="name">
          <h4><%= t.genre %></h4>
          (<%= t.level %>)
        </div> 
    
        <div class="image">
           <% if t.image.present? %>
              <%= image_tag t.image_url, class: "tweet-media" %>
           <% end %>

           <% if t.video.present? %>
              <%= video_tag t.video_url, controls: true, class: "tweet-media" %>
           <% end %>

            <% if t.youtube_url.present? && find_youtube_url(t.youtube_url).present? %>
              <iframe
                 class="tweet-media"
                  src="https://www.youtube.com/embed/<%= find_youtube_url(t.youtube_url) %>">
              </iframe>
            <% end %>
        </div>
    
        <div class="detail">
            <p>部位：<%= t.part %></p>
            <p>器具：<%= t.tool %></p>
            <p>必要なスペース：<%= t.size %></p>
            <p>ジャンプ：<%= t.jump %></p>
            <p>メモ：<%= t.note %></p>
        </div>

        <div class="user">
          <%= t.user.email %>
      
          <% if user_signed_in? %>
          <% if current_user.already_liked?(t) %>
            <%= link_to tweet_like_path(id: t.id, tweet_id: t.id), data: { turbo_method: :delete } do %>
                <i class="fas fa-heart"></i><%= t.likes.count %>
            <% end %>
          <% else %>
            <%= link_to tweet_likes_path(id: t.id, tweet_id: t.id), data: { turbo_method: :post }  do %>
                <i class="far fa-heart"></i><%= t.likes.count %>
            <% end %>
          <% end %>
          <% else %>
              <i class="far fa-heart"></i><%= t.likes.count %>
          <% end %> 
        </div>
    
      <div class="link">
          <%= t.created_at %>
              <%= link_to "詳細へ", tweet_path(t.id) %>
              <%= link_to "編集する", edit_tweet_path(t.id) %>
              <%= link_to "削除する", tweet_path(t), data: { turbo_method: :delete } %>
      </div>
    </div>
  <% end %>
</div>
